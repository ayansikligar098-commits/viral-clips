# Copy to .env and fill in. NEVER commit a real .env with secrets.
SECRET_KEY=change-me-to-a-long-random-secret
# Port the backend listens on (Render / Docker set PORT for you; default 8000)
PORT=8000
# CORS — env-based, comma-separated. Local dev default is localhost:3000.
# For a deployment, set this to your real frontend origin, e.g.:
# CORS_ORIGINS=https://viral-clips.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Temporary free-tunnel test ONLY (trycloudflare random subdomains).
# Leave empty in production. Example value:
# CORS_ALLOW_ORIGIN_REGEX=https://.*\.trycloudflare\.com
CORS_ALLOW_ORIGIN_REGEX=
# Fernet key for encrypting Instagram tokens at rest (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=
DATABASE_URL=sqlite:///./viral_clips.db
STORAGE_DIR=./storage
WHISPER_MODEL=tiny
MAX_CLIPS_PER_VIDEO=5
DEFAULT_CLIPS_PER_VIDEO=3
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_DURATION_SECONDS=10800
# Instagram / Meta Graph API (optional until a real Meta app exists)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/instagram/callback
GRAPH_API_VERSION=v21.0
